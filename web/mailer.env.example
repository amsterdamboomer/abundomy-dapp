# Voorbeeld-config voor de Abundomy mailer-service (Fase 1).
# Kopieer naar een veilige plek (NIET in git), bv. /etc/abundomy-mailer.env (chmod 600),
# en verwijs ernaar vanuit de systemd-unit met EnvironmentFile=.
#
# SMTP-submission via de mailserver van reikiwereld.eu (poort 25 op SER5 is dicht; 587/465 open).

# Gebruik de UITGAANDE (SMTP) server uit je mail-control-panel (topplatform/premiumantispam).
# mail.reikiwereld.eu presenteert een VERLOPEN cert → liever de officiële submission-host hier.
SMTP_HOST=mail.reikiwereld.eu
SMTP_PORT=587                       # 587 = STARTTLS, of 465 = impliciete TLS
SMTP_USER=noreply@reikiwereld.eu    # de mailbox-login
SMTP_PASS=__zet_hier_het_wachtwoord__
# Geen spaties/quotes nodig — de display-naam ("Abundomy Money") voegt de mailer zelf toe:
MAIL_FROM=noreply@reikiwereld.eu

# Noodklep als de mailserver een verlopen/onjuist cert heeft (verbinding blijft versleuteld,
# maar zonder cert-controle). Zet op 1 om door te kunnen; liever een geldige server gebruiken.
# SMTP_TLS_INSECURE=1

# Optioneel: app-URL in de mail (default https://app.reikiwereld.eu/app/)
# ABUNDOMY_APP_URL=https://app.reikiwereld.eu/app/

# LET OP: ABUNDOMY_COMMUNITY_SECRET hier NIET zetten tenzij de relay-service hem óók
# expliciet zet — de mailer moet exact dezelfde sleutel gebruiken als de relay om
# e-mailadressen te kunnen ontsleutelen. De relay draait nu op de default, dus laat
# deze leeg.
