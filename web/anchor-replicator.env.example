# Voorbeeld-config voor de Abundomy anchor-replicator (IPFS-only traject).
# Kopieer naar /etc/abundomy-anchor-replicator.env (chmod 600) op de Hetzner-box en
# verwijs ernaar vanuit de systemd-unit met EnvironmentFile=.
#
# Deze service repliceert de OrbitDB-stores EN spiegelt elk OrbitDB-block naar het
# Kubo-anker (zodat relay-loze browsers ze via bitswap van het anker halen).

# Kubo-RPC van het anker. OP DE HETZNER-BOX is dit lokaal:
ABUNDOMY_KUBO_RPC=http://127.0.0.1:5001
# (Lokaal testen vanaf SER5 kan via een SSH-tunnel naar een vrije poort, bv.:
#   ssh -N -L 5099:127.0.0.1:5001 root@178.105.222.179
#  en dan ABUNDOMY_KUBO_RPC=http://127.0.0.1:5099 — let op: 5001 lokaal is SER5's
#  EIGEN Kubo (v0.35), NIET het anker. Gebruik een andere poort voor de tunnel.)

# Multiaddr van het anker om als transport/pubsub-peer te dialen. Leeg = uit relay.json.
# ABUNDOMY_ANCHOR_ADDR=/dns4/178-105-222-179.k51qzi5uqu5dhg914bwk9z8r2da9ng7tlwo9i2v7ccg4r9elb9usk11s01lx5g.libp2p.direct/tcp/4002/tls/ws/p2p/12D3KooWDF22jexz4kUJgAzGaZ9f3gZr4pPkUnMKpGoUeLaQifv3

# Persistente data-root (OrbitDB + Helia-blocks van DEZE replicator).
# ABUNDOMY_REPL_ROOT=/var/lib/abundomy-anchor-repl/

# --- transport-laag (kies optie A of B; zie de kop van anchor-replicator.mjs) ---
# Optie A (eenvoudigst, mits het anker circuit-relay-v2 aanzet): laat LISTEN leeg.
#   Op het anker: `ipfs config --json Swarm.RelayService.Enabled true` + herstart.
#   Browsers bereiken deze replicator dan via het anker als relay → head-exchange werkt.
#
# Optie B: deze replicator luistert zelf op een browser-bereikbare wss (eigen
# AutoTLS/nginx-wss op de Hetzner-box) en announce't dat adres.
# ABUNDOMY_REPL_LISTEN=/ip4/0.0.0.0/tcp/4103/ws
# ABUNDOMY_REPL_ANNOUNCE=/dns4/<jouw-host>/tcp/443/tls/ws

# Mirroring uitzetten (alleen repliceren, niets naar Kubo) — normaal NIET zetten.
# ABUNDOMY_MIRROR=0
